# Editor used by CLI
export EDITOR="nvim"
export SUDO_EDITOR="$EDITOR"


# Essential environment variables from your current setup
export HOMEBREW_NO_ANALYTICS=1
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export THOR_MERGE="nvim -d"
export DOCKER_BUILDKIT=1

# Homebrew compiler/pkg-config flags for openssl@3
export LDFLAGS="-L/opt/homebrew/opt/openssl@3/lib"
export CPPFLAGS="-I/opt/homebrew/opt/openssl@3/include"
export PKG_CONFIG_PATH="/opt/homebrew/opt/openssl@3/lib/pkgconfig"
# Hardcoded to avoid slow brew command on every shell startup
export RUBY_CONFIGURE_OPTS="--with-libyaml-dir=/opt/homebrew/opt/libyaml"

# PATH, highest priority first. Relative entries (./bin, node_modules/.bin)
# are kept LAST so a repo's bin/ can't shadow real commands.
PATH="/opt/homebrew/bin:/opt/homebrew/sbin"
PATH="$PATH:/opt/homebrew/opt/openssl@3/bin"
PATH="$PATH:$HOME/.rbenv/bin:$HOME/.local/bin"
PATH="$PATH:$HOME/.yarn/bin:$HOME/.config/yarn/global/node_modules/.bin"
PATH="$PATH:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
PATH="$PATH:./bin:./node_modules/.bin"
export PATH


# Source your custom API keys if they exist
if [ -f ~/code/dotfiles/api_keys ]; then
    source ~/code/dotfiles/api_keys
fi

# Bat theme (for better file previews)
export BAT_THEME=ansi

# Claude Code: classic renderer, so the conversation stays in the tmux scrollback for copy mode.
# Unset is not enough: Claude Code can still pick fullscreen (alternate screen, no scrollback) itself.
export CLAUDE_CODE_NO_FLICKER=0
# Claude Code: full 24-bit colour inside tmux (tmux passes RGB through, see tmux/.tmux.conf),
# so the generated theme (scripts/apply_claude_theme.sh) shows exact colours.
export CLAUDE_CODE_TMUX_TRUECOLOR=1

# OpenStack CLI: default cloud from ~/.config/openstack/clouds.yaml (Infomaniak)
export OS_CLOUD=chalet-production

# SSH keys live in 1Password; its agent serves ssh, git and Kamal (net-ssh).
export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
