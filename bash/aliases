# Docker
# dcr is a function now. Bash expands an alias before it parses a function
# definition, so re-sourcing this file while the old alias is still loaded
# would turn `dcr() {` into `docker compose run --rm app() {` and fail to
# parse. Clearing it first makes the file safe to source twice.
unalias dcr 2>/dev/null || true

alias dcu="rm -f tmp/pids/server.pid && docker compose up -d && docker compose logs -f"
