# History control
shopt -s histappend
HISTCONTROL=ignoreboth
HISTSIZE=32768
HISTFILESIZE="${HISTSIZE}"
# Note: shared-across-tabs history is wired up in bash/init, after Starship
# (which resets PROMPT_COMMAND), so our hook isn't clobbered.

# Autocompletion
if [ -z "${BASH_COMPLETION_VERSINFO:-}" ]; then
  # Try Homebrew bash completion first
  if [ -r "/opt/homebrew/etc/profile.d/bash_completion.sh" ]; then
    source "/opt/homebrew/etc/profile.d/bash_completion.sh"
  # Fallback to system bash completion
  elif [ -f /usr/share/bash-completion/bash_completion ]; then
    source /usr/share/bash-completion/bash_completion
  fi
fi

# PATH is built in bash/envs. Disable command hashing so the relative
# ./bin entries are re-scanned on every lookup as you change directories.
set +h